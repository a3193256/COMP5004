   "source": [
    "def rotate_right(xs: list, k: int) -> list:\n",
    "   n=len(xs)\n",
    "   k%=n\n",
    "   out=[None]*n\n",
    "   for i in range(n):\n",
    "    out[(i+k)%n]=xs[i]\n",
    "   return out\n",
    "\n",
    "rotate_right([1,2,3,4,5,6],2)\n"
   ]
  }
 ],
